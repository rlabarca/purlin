{
  "name": "purlin",
  "version": "0.10.0",
  "description": "Rule-proof spec-driven development: specs define rules, proofs say how each rule is shown, tests prove it",
  "author": {
    "name": "Rich LaBarca",
    "url": "https://github.com/rlabarca"
  },
  "repository": "https://github.com/rlabarca/purlin",
  "license": "MIT",
  "mcpServers": {
    "purlin": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/purlin_python.sh",
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp/purlin/server.py"
      ],
      "env": {
        "PURLIN_PYTHON_SOFT": "1"
      }
    }
  },
  "keywords": [
    "specs",
    "testing",
    "audit",
    "rules",
    "proofs"
  ]
}
