{
  "version": "0.10.0",
  "gate": "passed",
  "mutation_engine": "auto",
  "audit_parallel": 4,
  "tests": [
    {
      "name": "pytest",
      "run": "python3 -m pytest --ignore=mutants {files} --junitxml={report}",
      "report": ".purlin/runtime/reports/pytest.xml",
      "format": "junit",
      "files": [
        "**/test_*.py",
        "**/*_test.py"
      ]
    }
  ],
  "ci": "github"
}
