# Purlin runtime (generated, not committed)
.purlin/runtime/

# Purlin plugin cache
.purlin/plugins/__pycache__/

# Dashboard HTML (copied by purlin:init and refreshed by purlin:init --update)
/purlin-report.html

# Dashboard data, regenerated locally, never committed
.purlin/report-data.js

# Plugin copies the update backed up before refreshing them
.purlin/plugins/*.local-*.bak
