{
  "version": "0.10.0",
  "tests": [
    {
      "name": "pytest",
      "run": "python3 -m pytest -q -p no:cacheprovider {files} --junitxml={report}",
      "report": ".purlin/runtime/reports/pytest.xml",
      "format": "junit",
      "files": [
        "dev/test_*.py"
      ]
    },
    {
      "name": "shell",
      "run": "bash {files}",
      "report": null,
      "format": "exit",
      "files": [
        "dev/test_*.sh"
      ]
    }
  ]
}
