# Purlin runtime (generated, not committed)
.purlin/runtime/

# Purlin cache (Proof Integrity and Proof Design results, additional criteria)
.purlin/cache/

# Purlin plugin cache
.purlin/plugins/__pycache__/

# Per-user config overlay (machine-local overrides, never shared)
.purlin/config.local.json

# Dashboard HTML (symlinked from the installed plugin)
/purlin-report.html

# Dashboard focus stamp (regenerated beside the digest, never committed)
.purlin/report-stamp.js
