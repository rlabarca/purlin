# Purlin runtime: the test reports and the run log, never committed
.purlin/runtime/

# Dashboard HTML (copied by purlin:init and refreshed by purlin:init --update)
/purlin-report.html

# Dashboard data, regenerated locally, never committed
.purlin/report-data.js

# .purlin/evidence/ and .purlin/tests.md are tracked on purpose: they are
# the evidence of each run, for somebody who did not make it to read.
