# Purlin runtime: the test reports and the run log, never committed
.purlin/runtime/

# Dashboard page, rewritten with its data, never committed
/purlin-report.html

# Dashboard data, regenerated locally, never committed
.purlin/report-data.js

# Python's bytecode cache, never committed
__pycache__/

# .purlin/evidence/ is tracked on purpose: it is the evidence of each run,
# for somebody who did not make it to read.
