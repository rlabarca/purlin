# OS & Editors
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
mutants/
.venv/
env/
venv/

# Purlin Runtime & Cache
.purlin/runtime/
.purlin/config.local.json
.purlin/plugins/__pycache__/
.purlin/cache/
.purlin/report-stamp.js
.purlin/report-data.js

# The text rendering of a review brief, a local view of the committed JSON
*.brief.txt

# Plugin data (persists across updates)
.claude-plugin-data/

# MCP server config (machine-specific)
.mcp.json

# External reference repos (local dog-food)
dev/external-refs/

# Purlin Tool Logs & Artifacts
*.log
*.pid
*.mmd
!assets/src/*.mmd
*.png
!docs/images/*.png
*.jpeg

# Worktrees (both Purlin agent and Claude Code sub-agent)
.purlin/worktrees/
.claude/worktrees/
.purlin_worktree_label
.purlin_session.lock

# Claude Code per-user settings (machine-specific)
.claude/settings.local.json

# Dashboard HTML (symlinked from framework)
/purlin-report.html

# Transient planning artifacts
PURLIN_AGENT_PLAN.md

# Credential files (must never be committed)
credentials.json
*.credentials
*.secret

# Temp
tmp/
dist/
build/
.playwright-mcp/

# Where this machine keeps the installed plugin (read by .purlin/hooks/)
.purlin/plugin-root
