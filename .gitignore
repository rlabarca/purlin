# OS & Editors
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
mutants/
.venv/
env/
venv/

# Purlin runtime
.purlin/runtime/
.purlin/plugins/__pycache__/
.purlin/report-data.js

# The text rendering of a brief, a local view of the committed JSON beside it
.purlin/briefs/**/*.brief.txt

# MCP server config (machine-specific)
.mcp.json

# External reference repos (local dog-food)
dev/external-refs/

# Purlin Tool Logs & Artifacts
*.log
*.pid
*.png
!docs/images/*.png
*.jpeg

# Claude Code sub-agent worktrees
.claude/worktrees/

# Claude Code per-user settings (machine-specific)
.claude/settings.local.json

# Dashboard HTML (copied by purlin:init and by dev/build_report.py)
/purlin-report.html

# Credential files (must never be committed)
credentials.json
*.credentials
*.secret

# Temp
tmp/
dist/
build/
.playwright-mcp/

# Where this machine keeps the installed plugin (read by .purlin/hooks/)
.purlin/plugin-root
